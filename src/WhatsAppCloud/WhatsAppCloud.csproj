<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The missing .NET SDK for Meta's WhatsApp Business Cloud API. Send text, template and media messages; verify webhooks.</Description>
    <AssemblyTitle>WhatsAppCloud.Net</AssemblyTitle>
    <Authors>Eslam Ashraf;Github Contributors</Authors>
    <PackageTags>whatsapp;whatsapp-cloud-api;meta;messaging;sdk</PackageTags>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Version>1.1.0</Version>
    <PackageId>WhatsAppCloud.Net</PackageId>
    <RootNamespace>WhatsAppCloud</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <RepositoryUrl>https://github.com/SENESO/WhatsAppCloud.Net</RepositoryUrl>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/SENESO/WhatsAppCloud.Net</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.1.0: media upload (UploadMediaAsync), send-by-media-ID methods, GetMediaInfoAsync/DeleteMediaAsync, richer webhook parsing (media IDs, captions for all media types, interactive button/list replies), constant-time webhook challenge verification, nullable reference type annotations, dependency updates.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>


  <ItemGroup>
    <None Include="../../docs/icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
